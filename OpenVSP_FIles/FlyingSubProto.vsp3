      <CustomGeom>
        <Width Value="2.000000000000000000e+00" ID="TUMXOPTMYAB"/>
        <SeatHeight Value="2.500000000000000000e-01" ID="EAQGPNFFWLK"/>
        <SeatLength Value="1.500000000000000000e+00" ID="DLCXNGSWBLW"/>
        <BackHeight Value="2.899999999999999911e+00" ID="HBVVZWXYWQK"/>
        <BackThick Value="2.500000000000000000e-01" ID="FMPZFSXNNLC"/>
